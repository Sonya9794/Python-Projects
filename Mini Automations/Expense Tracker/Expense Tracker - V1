import time
import os
import csv

data_path = os.path.join(os.path.dirname(__file__), 'expense_data.txt')

exit_main = False
exit_date = False

def add_expense(date, category, description, amount):
    with open(data_path, 'a') as expense_data:
        expense_data.write(f"{date.strip().lower()}|{category.strip().lower()}|{description.strip().lower()}|{amount.strip()}\n")
        time.sleep(0.5)
        print("\nYour expense has been logged!\n")

def view_expenses():
    expense_count = 1

    with open(data_path, 'r') as expense_data:
        for line in expense_data:
            if line != "\n":
                expense_details = line.split("|")

                expense_date = expense_details[0]
                expense_category = expense_details[1].capitalize()
                expense_description = expense_details[2].capitalize()
                expense_amount = int(expense_details[3])

                print(f"{expense_count}. {expense_date}: ${expense_amount} \nCategory: {expense_category}\nDescription: {expense_description}\n")
                time.sleep(0.1)

                expense_count += 1

def expenses_summary():
    total_items = 0
    total_spent = 0
    largest_expense = ['01/01/0000','None','None',0]

    with open(data_path, 'r') as expense_data:
        for line in expense_data:
            if line != "\n":
                expense_details = line.split("|")

                total_items += 1
                total_spent += float(expense_details[3])

                largest_cost = largest_expense[3]


                if float(expense_details[3]) > float(largest_cost):
                    largest_expense = expense_details

        largest_cost = largest_expense[3]

        print(f"\nHere is your spending summary:\n")
        time.sleep(0.5)
        print(f"Total expenses: {total_items}")
        time.sleep(0.25)
        print(f"Total spent: ${round(total_spent,2)}")
        time.sleep(0.25)
        print(f"Largest Expense: {largest_expense[1].capitalize().strip()} - {largest_expense[2].capitalize().strip()} (${round(float(largest_cost),2)} spent on {largest_expense[0]}.)\n")
        time.sleep(0.5)
        print("-- End of log --\n")

def categorical_summary():
    category_dict = {    }
    print("\n Here are your total costs by category:\n")

    with open(data_path, 'r') as expense_data:
        for line in expense_data:
            expense_details = line.split("|")
            category = expense_details[1].strip().lower()

            if category in category_dict:
                category_dict[category] += float(expense_details[3])
            else:
                category_dict[category] = float(expense_details[3])

        for category, total in category_dict.items():
            print(f"{category.capitalize().strip()}: ${round(total, 2)}")
            time.sleep(0.1)

    time.sleep(0.5)
    print("\n -- End of log -- \n")




