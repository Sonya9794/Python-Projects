def add_flashcard(dictionary, question, answer):
    with open(os.path.join(os.path.dirname(__file__), (f"{dictionary}.txt")), 'a') as dictionary:
        dictionary.write(f"{question}|{answer}\n")
    # dictionary["flashcard_question"].append(question)
    # dictionary["flashcard_answer"].append(answer)

def random_flashcards(dictionary, flash_count, question_count):
    card_numbers = random.sample(range(0, flash_count), question_count)
    number_correct = 0
    with open(os.path.join(os.path.dirname(__file__), (f"{dictionary}.txt")), 'r') as dictionary:
        for i, line in enumerate(dictionary):
            if i in card_numbers:
                card = line.split("|")
                card_question = card[0]
                card_answer = card[1]

                attempted_answer = input(f"\nWhat is the answer to \"{card_question}\"? ")

                if str(attempted_answer).strip().lower() == str(card_answer).strip().lower():
                    print("Correct!")
                    number_correct += 1
                else: 
                    print(f"Incorrect! The correct answer is {card_answer.strip()}.\n")

                time.sleep(0.5)

        print(f"\nYou answered {number_correct} questions correctly, with an overall score of {round(100*number_correct/question_count, 2)}%. Congrats!")

def count_flashcards(dictionary):
    with open(os.path.join(os.path.dirname(__file__), (f"{dictionary}.txt")), 'r') as dictionary:
        count = 0
        for line in dictionary:
            if line != '\n':
                count += 1
        return count

